# Variables de entorno de la plantilla.
# Copie este archivo como .env antes de levantar la aplicación:
#     cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)

# Caso del proyecto: healthsync | marketplace
CASO=marketplace

SECRET_KEY=plantilla-secreta

# Base de datos (MySQL 8.4)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app

# Cuenta de administrador que se crea al iniciar
ADMIN_EMAIL=admin@plantilla.test
ADMIN_PASSWORD=admin123

# Contraseña de las cuentas de prueba definidas en casos/<caso>/caso.json
SEED_PASSWORD=prueba123

# Robot C++
WORKER_TOKEN=worker-token
WORKER_INTERVAL_SECONDS=60

# API externa. Si EXTERNAL_API_BASE_URL queda vacía se usa el simulador.
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=simulada
